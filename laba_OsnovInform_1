#!/bin/bash

echo "Возможные махинации над директорией:"
echo "1 - Архивировать все файлы в папке"
echo "2 - Удалить все файлы, старше заданной даты"


if [ "$#" -lt 2 ];
then
	echo "Упс.. Вы должны передать 2 аргумента: <Пусть к папке> <режим работы>"
	exit 1
fi

dir_path="$1"
mode="$2"
cur_date=$(date +%Y-%m-%d)

if [ ! -d "$dir_path" ];
then
        echo "Не обманывай, такой папки не существует!"
        exit 1
fi


case $mode in

1) 
	read -p "Путь, куда хотите сохранить архив: " save_arch
	if [ ! -d "$save_arch" ];
	then
		mkdir -p "$save_arch"
	fi

	echo "Архивация..."

	for file_path in "$dir_path"/*;
	do
		if [ -f "$file_path" ] && [[ "$file_path" != *.tar_* ]];
		then
			filename=$(basename "$file_path")
			arch_name="${filename}.tar_${cur_date}"
        		echo "Выполняю архивацию..."
			tar -cf "$save_arch/$arch_name" -C "$dir_path" "$filename"
		else
        		echo "Ошибка: tar не смог создать архив. Проверьте параметры."
        		exit 1
		fi
	done
	echo "Архивация прошла успешно!"
;;

2)
	read -p "Файлы старше какой даты удалить?(ГГГГ-ММ-ДД)" limit_date
	if [[ ! "$limit_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]];
	then
		echo "Неверный формат ввода"
		exit 1
	fi

	lim_date_sec=$(date -d "$limit_date" +%s)

	for file_path in "$dir_path"/*;
        do
                if [ -f "$file_path" ];
                then
			file_date="${file_path##*_}"
                        if [[ "$file_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]];
			then
				file_sec=$(date -d "$file_date" +%s)
				if [ "$file_sec" -lt "$lim_date_sec" ];
				then

					rm "$file_path"
				fi
        		fi
		fi
        done

	echo "Файлы удалены, брат"
;;

*)
	echo "Ха, кажется ты промазал по клавише! Тебе нужно нажать 1 или 2"
	exit 1
;;

esac
