#!/bin/bash
a="Hello world"
s=5

c=14
n=$(($s+$c))
echo "s+c=$n"
echo "Сколько тебе лет?"
read age
if [ "$age" -eq 18 ]; then
	echo "ХХАХАХХАХАХА, ПОРА В АРМИЮ"
	echo "Выполняется звонок в военкомат..."
elif [ "$age" -gt 18 ]; then
	echo "УКЛОНЯЕШЬСЯ!?"
	echo "Мы едем за тобой"
else
	echo "Вернитесь через $((18-age)) лет"
fi

